includes:
  - phpstan-baseline.neon

parameters:
  level: max
  paths:
    - src
    - public/index.php
    - si.php
  tmpDir: /tmp/phpstan
  
  # Excludes
  excludePaths:
    - tests
    - vendor
    - _tmp_noenv_runner (?)
  
  # PHP version
  phpVersion: 80500

  # Type checking
  checkMissingCallableSignature: true

  # Error handling
  reportUnmatchedIgnoredErrors: true


