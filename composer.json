{
  "name": "sparkinsight/sparkinsight",
  "description": "SparkInsight review workflow platform with OAuth login and composer-based deployment.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.1||^8.2||^8.3||^8.4||^8.5",
    "slim/slim": "^4.14",
    "slim/psr7": "^1.7",
    "slim/php-view": "^3.3",
    "league/oauth2-client": "^2.0",
    "vlucas/phpdotenv": "^5.6",
    "doctrine/orm": "^3.0",
    "symfony/console": "^7.0",
    "henck/rtf-to-html": "^1.3",
    "tecnickcom/tc-lib-pdf": "^8.65"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "pcov/clobber": "^2.0",
    "phpstan/phpstan": "^1.10",
    "friendsofphp/php-cs-fixer": "^3.50"
  },
  "autoload": {
    "psr-4": {
      "SparkInsight\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SparkInsightTest\\": "tests/"
    }
  },
  "scripts": {
    "start": [
      "Composer\\Config::disableProcessTimeout",
      "php -S localhost:8000 -t public public/index.php"
    ],
    "deploy": "php tools/deploy/deploy.php sync",
    "deploy:status": "php tools/deploy/deploy.php status",
    "release:keygen": "php tools/release/generate_keys.php",
    "release:wizard": "php tools/release/prepare_wizard.php",
    "test": "php vendor/bin/phpunit --configuration phpunit.xml.dist",
    "test:install-sim": "php tools/ci/check_composer_install.php",
    "hooks:install": "git config core.hooksPath .githooks",
    "hooks:pre-commit": "php tools/ci/hook_pre_commit.php",
    "hooks:pre-push": [
      "php vendor/bin/phpunit --configuration phpunit.xml.dist --coverage-xml=tmp/coverage-xml --colors=never",
      "php tools/ci/check_method_coverage.php tmp/coverage-xml --warn-only"
    ],
    "coverage": [
      "php vendor/bin/phpunit --configuration phpunit.xml.dist --coverage-text --coverage-clover=coverage.xml --coverage-xml=tmp/coverage-xml --colors=never",
      "php tools/ci/check_method_coverage.php tmp/coverage-xml"
    ],
    "coverage:guard": "php tools/ci/check_method_coverage.php tmp/coverage-xml",
    "coverage:guard:v1": "php tools/ci/check_method_coverage.php tmp/coverage-xml",
    "coverage-html": "php vendor/bin/phpunit --configuration phpunit.xml.dist --coverage-html coverage-report"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
