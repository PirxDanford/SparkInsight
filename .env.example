# Local development settings for SparkInsight
APP_ENV=development
APP_URL=http://localhost:8000

# Database configuration (MariaDB by default, can be changed to pdo_pgsql for PostgreSQL)
DB_DRIVER=pdo_mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sparkinsight
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# LinkedIn support is available when configured.
OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=
