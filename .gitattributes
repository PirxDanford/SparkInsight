# Default: let Git detect text files and normalize them to LF in the repo.
* text=auto

# Source and config files must keep LF in the working tree even on Windows,
# so the php-cs-fixer line_ending rule does not fight core.autocrlf checkouts.
*.php  text eol=lf
*.neon text eol=lf
*.xml  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.sql  text eol=lf
*.md   text eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Truly binary files must not be modified.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
*.sig  binary
